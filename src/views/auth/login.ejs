<%- include("../partials/head") %>
<%- include("../partials/public-nav") %>

<main class="section">
  <div class="container narrow">
    <%- include("../partials/flash") %>
    <div class="auth-card">
      <div class="auth-header">
        <div class="brand-logo large"><%= app.shortName %></div>
        <h1><%= t("auth.title") %></h1>
        <p><%= t("auth.roleHelp") %></p>
      </div>

      <form action="/login" method="post" class="auth-form">
        <div class="form-row">
          <label for="username"><%= t("auth.username") %></label>
          <input id="username" name="username" type="text" required />
        </div>
        <div class="form-row">
          <label for="password"><%= t("auth.password") %></label>
          <input id="password" name="password" type="password" required />
        </div>
        <div class="form-row">
          <label for="locale"><%= t("auth.language") %></label>
          <select id="locale" name="locale">
            <% languages.forEach((language) => { %>
              <option value="<%= language.code %>" <%= language.code === locale ? "selected" : "" %>>
                <%= language.label %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="button button-primary button-full">
          <%= t("auth.submit") %>
        </button>
      </form>

      <div class="demo-note">
        <strong>Seeded internal accounts:</strong>
        <p class="muted">
          Use the exact usernames shown below. No spaces are used in usernames such as
          <code>mainadmin</code> and <code>submanager</code>.
        </p>
        <ul>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="admin" data-password="admin123">
              admin / admin123
            </button>
          </li>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="mainadmin" data-password="main123">
              mainadmin / main123
            </button>
          </li>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="manager" data-password="manager123">
              manager / manager123
            </button>
          </li>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="submanager" data-password="sub123">
              submanager / sub123
            </button>
          </li>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="director" data-password="director123">
              director / director123
            </button>
          </li>
          <li>
            <button type="button" class="button button-secondary button-small demo-account-btn" data-username="user" data-password="user123">
              user / user123
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
